# Use the machine-wide pnpm content-addressable store on T: instead of
# duplicating packages inside every project.
store-dir=T:\DevLibs\pnpm-store

# Electron packaging tools need a flat node_modules; pnpm still hard-links
# every package from the central store.
node-linker=hoisted

# electron/install.js reads electron_config_cache (ELECTRON_CACHE is ignored
# by @electron/get 5.x). Keeps downloaded Electron runtimes on T:.
electron_config_cache=T:\DevLibs\electron-cache

# castLabs Electron with bundled Widevine CDM.
# Standard Electron 35+ dropped the widevine-cdm-path switch, making Widevine
# unavailable. castLabs provides a drop-in replacement with Widevine built-in.
@castlabs:registry=https://registry.castlabs.net

# Allow electron's post-install download script to run (downloads the binary).
# Without this, pnpm v9+ blocks build scripts by default.
only-built-dependencies[]=electron
