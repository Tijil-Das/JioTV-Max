# Electron packaging tools need a flat node_modules; pnpm still hard-links
# every package from the store.
node-linker=hoisted

# Allow electron and esbuild post-install download scripts to run.
# Modern pnpm requires explicit approval for build scripts.
only-built-dependencies[]=electron
only-built-dependencies[]=esbuild

# Prevent pnpm from skipping lifecycle scripts on repeat installs
optimistic-repeat-install=false
enable-pre-post-scripts=true
