{
  "name": "jiotv-max-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "JioTV Max Monorepo — JioTV-Max-Windows desktop application and Website",
  "scripts": {
    "dev": "pnpm --filter jiotv-max dev",
    "dev:wv": "pnpm --filter jiotv-max dev:wv",
    "dev:web": "pnpm --filter jiotv-max dev:web",
    "build": "pnpm --filter jiotv-max build",
    "preview": "pnpm --filter jiotv-max preview",
    "typecheck": "pnpm --filter jiotv-max typecheck",
    "test": "pnpm --filter jiotv-max test",
    "test:watch": "pnpm --filter jiotv-max test:watch",
    "pack:dir": "pnpm --filter jiotv-max pack:dir",
    "dist": "pnpm --filter jiotv-max dist"
  }
}
