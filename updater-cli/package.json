{
  "name": "jiotv-max-updater-cli",
  "version": "1.0.0",
  "description": "Interactive pro-grade release CLI for JioTv Max",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --import tsx/esm src/index.ts",
    "release": "node --import tsx/esm src/index.ts",
    "watch": "node --import tsx/esm src/index.ts watch",
    "status": "node --import tsx/esm src/index.ts status",
    "blockmap": "node --import tsx/esm src/index.ts blockmap",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "boxen": "^9.0.0",
    "cac": "^7.1.0",
    "cli-spinners": "^3.4.0",
    "execa": "^10.2.1",
    "figlet": "^1.12.0",
    "gradient-string": "^3.0.0",
    "is-unicode-supported": "^2.1.0",
    "log-update": "^8.0.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "string-width": "^8.3.0",
    "strip-ansi": "^7.2.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
